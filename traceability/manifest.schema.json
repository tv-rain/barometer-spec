{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Barometer traceability manifest format 1",
  "$comment": "Structural validation only. Apply the semantic rules in README.md before accepting claims.",
  "type": "object",
  "properties": {
    "format_version": {
      "type": "integer",
      "const": 1
    },
    "specification": {
      "$ref": "#/$defs/specification"
    },
    "implementation": {
      "$ref": "#/$defs/baseline"
    },
    "coverage": {
      "$ref": "#/$defs/coverage"
    },
    "requirements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/requirement"
      },
      "minItems": 0
    },
    "cases": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/case"
      },
      "minItems": 0
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      },
      "minItems": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/evidence"
      },
      "minItems": 0
    }
  },
  "required": [
    "format_version",
    "specification",
    "implementation",
    "coverage",
    "requirements",
    "cases",
    "issues",
    "evidence"
  ],
  "additionalProperties": false,
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "record_id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*(?![\\s\\S])"
    },
    "requirement_id": {
      "type": "string",
      "pattern": "^REQ-[A-Z][A-Z0-9]*(?:-[A-Z0-9]+)*-(?!0000)[0-9]{4}(?![\\s\\S])"
    },
    "revision": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})(?![\\s\\S])"
    },
    "repository": {
      "type": "string",
      "pattern": "^https://[^\\s/?#@]+/[^\\s?#]+(?![\\s\\S])"
    },
    "path": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*//)[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*(?![\\s\\S])"
    },
    "baseline": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      },
      "required": [
        "repository",
        "revision"
      ],
      "additionalProperties": false
    },
    "specification": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "version": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "repository",
        "revision",
        "version"
      ],
      "additionalProperties": false
    },
    "location": {
      "type": "object",
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "selector": {
          "$ref": "#/$defs/text"
        },
        "state": {
          "type": "string",
          "enum": [
            "planned",
            "existing"
          ]
        }
      },
      "required": [
        "path",
        "selector",
        "state"
      ],
      "additionalProperties": false
    },
    "reference": {
      "type": "object",
      "properties": {
        "repository": {
          "$ref": "#/$defs/repository"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        },
        "path": {
          "$ref": "#/$defs/path"
        },
        "selector": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "repository",
        "revision",
        "path",
        "selector"
      ],
      "additionalProperties": false
    },
    "coverage": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "partial",
            "catalog_complete"
          ]
        },
        "unallocated_sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/path"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "mode",
        "unallocated_sources",
        "notes"
      ],
      "additionalProperties": false
    },
    "support": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "core",
            "platform",
            "field"
          ]
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "type": "string",
          "enum": [
            "unclaimed",
            "unsupported",
            "supported"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "kind",
        "scope",
        "status",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "supported"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "requirement": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/requirement_id"
        },
        "implementation_status": {
          "type": "string",
          "enum": [
            "not_implemented",
            "planned",
            "partial",
            "blocked",
            "unsupported",
            "implemented"
          ]
        },
        "implementation_locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "case_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "issue_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "review_evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "support": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/support"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "implementation_status",
        "implementation_locations",
        "case_ids",
        "issue_ids",
        "review_evidence_ids",
        "support",
        "notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "implementation_status": {
                "const": "implemented"
              }
            },
            "required": [
              "implementation_status"
            ]
          },
          "then": {
            "properties": {
              "implementation_locations": {
                "minItems": 1,
                "items": {
                  "properties": {
                    "state": {
                      "const": "existing"
                    }
                  }
                }
              },
              "case_ids": {
                "minItems": 1
              },
              "review_evidence_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "implementation_status": {
                "enum": [
                  "not_implemented",
                  "planned",
                  "partial",
                  "blocked",
                  "unsupported"
                ]
              }
            },
            "required": [
              "implementation_status"
            ]
          },
          "then": {
            "properties": {
              "support": {
                "items": {
                  "properties": {
                    "status": {
                      "enum": [
                        "unclaimed",
                        "unsupported"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "case": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/record_id"
        },
        "location": {
          "$ref": "#/$defs/location"
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "status": {
          "type": "string",
          "enum": [
            "planned",
            "not_run",
            "passed",
            "failed",
            "blocked"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/record_id"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "location",
        "scope",
        "status",
        "evidence_ids"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "planned"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "location": {
                "properties": {
                  "state": {
                    "const": "planned"
                  }
                }
              },
              "evidence_ids": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "not_run",
                  "passed",
                  "failed",
                  "blocked"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "location": {
                "properties": {
                  "state": {
                    "const": "existing"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "enum": [
                  "passed",
                  "failed"
                ]
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "not_run"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/record_id"
        },
        "disposition": {
          "type": "string",
          "enum": [
            "open",
            "in_review",
            "accepted_adoption_pending",
            "rejected_or_deferred",
            "closed"
          ]
        },
        "finding": {
          "$ref": "#/$defs/reference"
        },
        "resolution_references": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/reference"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "notes": {
          "$ref": "#/$defs/text"
        }
      },
      "required": [
        "id",
        "disposition",
        "finding",
        "resolution_references",
        "notes"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "disposition": {
                "const": "closed"
              }
            },
            "required": [
              "disposition"
            ]
          },
          "then": {
            "properties": {
              "resolution_references": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/record_id"
        },
        "kind": {
          "type": "string",
          "enum": [
            "conformance",
            "review",
            "platform",
            "field"
          ]
        },
        "reference": {
          "$ref": "#/$defs/reference"
        },
        "specification_revision": {
          "$ref": "#/$defs/revision"
        },
        "implementation_revision": {
          "$ref": "#/$defs/revision"
        },
        "requirement_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/requirement_id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "scope": {
          "$ref": "#/$defs/text"
        },
        "case_results": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/case_result"
          },
          "uniqueItems": true
        }
      },
      "required": [
        "id",
        "kind",
        "reference",
        "specification_revision",
        "implementation_revision",
        "requirement_ids",
        "scope",
        "case_results"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "conformance"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "properties": {
              "case_results": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "case_results": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    },
    "case_result": {
      "type": "object",
      "properties": {
        "case_id": {
          "$ref": "#/$defs/record_id"
        },
        "result": {
          "type": "string",
          "enum": [
            "passed",
            "failed",
            "blocked"
          ]
        }
      },
      "required": [
        "case_id",
        "result"
      ],
      "additionalProperties": false
    }
  }
}
